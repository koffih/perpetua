# Perpetua project configuration: @NAME@
# Sourced by the runner as a shell file: KEY=value, quote values with spaces.
# Reference: https://koffih.github.io/perpetua/reference/configuration/

# Absolute path of the repository the sessions work in.
PROJECT_DIR=@PROJECT_DIR@

# What each session is asked to do. /autonomous-mode keeps one session working for hours.
PROMPT='/autonomous-mode follow the plan'

# Standing rules appended to the system prompt of every session (relative to PROJECT_DIR).
DIRECTIVE_FILE=.perpetua/directive.md

# Hard ceiling of one session (timeout(1) syntax: 90m, 4h).
MAX_SESSION=4h

# Yield while the operator used Claude Code within this many minutes (0 disables).
PRESENCE_WINDOW_MIN=10

# Pause after a usage limit is reported, in seconds.
BACKOFF_SECONDS=3600

# Attention gate: a line of QUESTION_FILE matching QUESTION_PATTERN whose value is not
# "none" means a question waits for the operator; sessions then run at most once per
# QUESTION_THROTTLE_SECONDS. Leave QUESTION_FILE empty to disable.
QUESTION_FILE=PLAN.md
QUESTION_PATTERN='Pending question[*_ ]*:'
QUESTION_THROTTLE_SECONDS=21600

# Claude Code invocation. Nobody can answer a permission prompt at night.
CLAUDE_BIN=claude
CLAUDE_ARGS='--dangerously-skip-permissions'
MODEL=

# Session journals kept in the state directory.
SESSION_RETENTION=200

# Optional shell command run after every session. Receives PERPETUA_PROJECT,
# PERPETUA_OUTCOME, PERPETUA_EXIT_CODE, PERPETUA_JOURNAL, PERPETUA_STATE_DIR,
# PERPETUA_PROJECT_DIR.
POST_SESSION_HOOK=
