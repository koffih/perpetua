#!/usr/bin/env bash
# Perpetua session runner.
#
# Runs one guarded, unattended Claude Code session for a registered project, then
# records its outcome. Invoked by the systemd unit perpetua@<project>.service, or
# directly through `perpetua run <project>`.
#
#   session <project> [--force]
#
# Admission gates, evaluated in this order (the first one that closes ends the run
# with exit status 0, so the timer keeps its cadence):
#   1. stop flag      $STATE/<project>/paused or <project dir>/.perpetua/STOP
#   2. exclusivity    a single session per project (flock)
#   3. back-off       a usage limit was hit recently
#   4. presence       the operator used Claude Code within PRESENCE_WINDOW_MIN
#   5. attention      a question for the operator is pending: at most one session
#                     per QUESTION_THROTTLE_SECONDS
# --force (or PERPETUA_FORCE=1) skips gates 4 and 5, never 1 to 3.
#
# Exit status: 0 the run was handled (session ran or a gate closed), 2 usage or
# configuration error, 3 the project directory is missing.
set -uo pipefail

readonly PERPETUA_VERSION="1.0.0"

usage() { echo "usage: session <project> [--force]" >&2; exit 2; }
[[ $# -ge 1 ]] || usage
name=$1; shift
force=${PERPETUA_FORCE:-0}
for arg in "$@"; do
	case "$arg" in
		--force) force=1 ;;
		*) usage ;;
	esac
done
[[ $name =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] || { echo "perpetua: invalid project name '$name'" >&2; exit 2; }

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
config_home=${XDG_CONFIG_HOME:-$HOME/.config}/perpetua
state_home=${XDG_STATE_HOME:-$HOME/.local/state}/perpetua
conf=$config_home/projects/$name.env
[[ -r $conf ]] || { echo "perpetua: unknown project '$name' (no $conf)" >&2; exit 2; }

# Unattended runs inherit a minimal PATH from systemd: add the usual user locations.
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.local/opt/node/bin:/usr/local/bin:$PATH"

# ---- Configuration defaults (overridden by the project file) ------------------------------
PROJECT_DIR=
PROMPT='/autonomous-mode'
DIRECTIVE_FILE=.perpetua/directive.md
MAX_SESSION=4h
PRESENCE_WINDOW_MIN=10
PRESENCE_DIR=$HOME/.claude/projects
BACKOFF_SECONDS=3600
LIMIT_PATTERN='usage limit|limit reached|rate_limit_error|"error":"rate_limit"'
QUESTION_FILE=
QUESTION_PATTERN='Pending question[*_ ]*:'
QUESTION_NONE='^(none|n/?a|-|aucune)?[.]?$'
QUESTION_THROTTLE_SECONDS=21600
CLAUDE_BIN=claude
CLAUDE_ARGS='--dangerously-skip-permissions'
MODEL=
SESSION_RETENTION=200
POST_SESSION_HOOK=
# shellcheck source=/dev/null
. "$conf"

state=$state_home/$name
mkdir -p "$state/sessions"
now=$(date +%s)

log() {
	local line
	line="$(date '+%F %T') $*"
	printf '%s\n' "$line" >> "$state/runner.log"
	printf '[%s] %s\n' "$name" "$*" >&2
}

[[ -n $PROJECT_DIR && -d $PROJECT_DIR ]] || { log "error: project directory '$PROJECT_DIR' not found"; exit 3; }

# ---- Gate 1: stop flag --------------------------------------------------------------------
if [[ -e $state/paused || -e $PROJECT_DIR/.perpetua/STOP ]]; then
	log "gate:stop paused by operator"
	exit 0
fi

# ---- Gate 2: exclusivity ------------------------------------------------------------------
exec 9> "$state/lock"
if ! flock -n 9; then
	log "gate:lock a session is already running"
	exit 0
fi

# ---- Gate 3: back-off after a usage limit ---------------------------------------------------
if [[ -f $state/backoff-until ]]; then
	until_ts=$(<"$state/backoff-until")
	if [[ $until_ts =~ ^[0-9]+$ ]] && (( now < until_ts )); then
		log "gate:backoff usage limit, waiting until $(date -d "@$until_ts" '+%F %T')"
		exit 0
	fi
	rm -f "$state/backoff-until"
fi

# ---- Gate 4: operator presence ------------------------------------------------------------
# Any Claude Code transcript written recently means a human is at work. Transcripts of
# sessions Perpetua launched itself (in any project) are recognised by id and ignored.
if (( ! force && PRESENCE_WINDOW_MIN > 0 )) && [[ -d $PRESENCE_DIR ]]; then
	recent=$(find "$PRESENCE_DIR" -name '*.jsonl' -mmin "-$PRESENCE_WINDOW_MIN" 2>/dev/null || true)
	if [[ -n $recent ]]; then
		# A session's transcript is <id>.jsonl; its subagents live under <id>/subagents/.
		own=$(cat "$state_home"/*/own-sessions 2>/dev/null | sed -E '/^$/d; s|.*|/&.jsonl\n/&/|' || true)
		if [[ -n $own ]]; then
			recent=$(grep -vF -- "$own" <<<"$recent" || true)
		fi
	fi
	if [[ -n $recent ]]; then
		log "gate:presence operator active in Claude Code within ${PRESENCE_WINDOW_MIN} min, yielding"
		exit 0
	fi
fi

# ---- Gate 5: pending question for the operator ----------------------------------------------
question_file=$QUESTION_FILE
[[ -z $question_file || $question_file = /* ]] || question_file=$PROJECT_DIR/$question_file
if (( ! force )) && [[ -n $question_file && -r $question_file ]]; then
	line=$(grep -m1 -E -- "$QUESTION_PATTERN" "$question_file" || true)
	question=$(sed -E 's/^[^:]*:[[:space:]]*//; s/^[*_]+[[:space:]]*//; s/[[:space:]]+$//' <<<"$line")
	shopt -s nocasematch
	if [[ -n $line && ! $question =~ $QUESTION_NONE ]]; then
		last=$(cat "$state/last-question-run" 2>/dev/null || echo 0)
		if (( now - last < QUESTION_THROTTLE_SECONDS )); then
			log "gate:attention question pending for the operator, next session after $(date -d "@$((last + QUESTION_THROTTLE_SECONDS))" '+%F %T')"
			exit 0
		fi
		echo "$now" > "$state/last-question-run"
	fi
	shopt -u nocasematch
fi

# ---- Session ------------------------------------------------------------------------------
command -v "$CLAUDE_BIN" > /dev/null || { log "error: '$CLAUDE_BIN' not found in PATH"; exit 2; }

read -r -a extra <<<"$CLAUDE_ARGS"
cmd=("$CLAUDE_BIN" -p "$PROMPT" --output-format stream-json --verbose "${extra[@]}")
[[ -n $MODEL ]] && cmd+=(--model "$MODEL")
directive=$DIRECTIVE_FILE
[[ $directive = /* ]] || directive=$PROJECT_DIR/$directive
if [[ -r $directive ]]; then
	cmd+=(--append-system-prompt "$(cat "$directive")")
else
	log "warning: no directive at $directive, the session runs on its prompt alone"
fi

stamp=$(date '+%Y%m%dT%H%M%S')
journal=$state/sessions/$stamp.jsonl
log "session:start $stamp (limit $MAX_SESSION)"
started=$(date +%s)
# fd 9 holds the lock: the session and its children must not inherit it.
(cd "$PROJECT_DIR" && exec timeout --kill-after=60 "$MAX_SESSION" "${cmd[@]}") > "$journal" 2>&1 < /dev/null 9>&- &
child=$!
interrupted=0
trap 'interrupted=1; kill -TERM "$child" 2> /dev/null' TERM INT HUP

# Register the Claude Code session id as soon as it is announced, so the presence gate
# of every project ignores this session's transcripts while it is still running.
for _ in $(seq 240); do
	sid=$(grep -m1 -oE '"session_id":"[^"]+"' "$journal" 2> /dev/null | cut -d'"' -f4 || true)
	if [[ -n $sid ]]; then
		echo "$sid" >> "$state/own-sessions"
		break
	fi
	kill -0 "$child" 2> /dev/null || break
	sleep 0.5
done

wait "$child"
code=$?
if ((interrupted)); then
	wait "$child" 2> /dev/null
	code=130
fi
trap - TERM INT HUP
ended=$(date +%s)

# Usage limits are looked for in what Claude Code itself reports (error events, a result
# flagged as an error, stderr), never in tool output or in the agent's own report.
outcome=ok
if ((interrupted)); then
	outcome=interrupted
elif grep -E '^([^{]|\{"type":"(error|rate_limit)|\{"type":"result".*"is_error":true)' "$journal" \
	| grep -qiE -- "$LIMIT_PATTERN"; then
	outcome=rate_limited
	echo $((ended + BACKOFF_SECONDS)) > "$state/backoff-until"
elif (( code == 124 || code == 137 )); then
	outcome=timeout
elif (( code != 0 )); then
	outcome=error
fi

if python3 "$here/record.py" --project "$name" --state "$state" --journal "$journal" \
	--exit-code "$code" --outcome "$outcome" --started "$started" --ended "$ended" \
	--version "$PERPETUA_VERSION"; then
	# The recorder may refine the outcome (an "ok" run without a successful result is an error).
	outcome=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["outcome"])' "$state/last-session.json" 2> /dev/null || echo "$outcome")
else
	log "warning: could not record the session summary"
fi

log "session:end $stamp outcome=$outcome exit=$code duration=$(( (ended - started) / 60 ))min"
[[ $outcome = rate_limited ]] && log "backoff: usage limit reached, pausing $((BACKOFF_SECONDS / 60)) min"

# Retention: keep the most recent session journals only.
if (( SESSION_RETENTION > 0 )); then
	find "$state/sessions" -maxdepth 1 -name '*.jsonl' -printf '%f\n' | sort -r \
		| tail -n +"$((SESSION_RETENTION + 1))" | while read -r old; do rm -f "$state/sessions/$old"; done
fi

if [[ -n $POST_SESSION_HOOK ]]; then
	PERPETUA_PROJECT=$name PERPETUA_OUTCOME=$outcome PERPETUA_EXIT_CODE=$code \
	PERPETUA_JOURNAL=$journal PERPETUA_STATE_DIR=$state PERPETUA_PROJECT_DIR=$PROJECT_DIR \
		timeout 120 sh -c "$POST_SESSION_HOOK" >> "$state/runner.log" 2>&1 9>&- \
		|| log "warning: post-session hook failed"
fi
exit 0
