#!/usr/bin/env bash
# perpetua: continuous, unattended Claude Code sessions with operator-grade guardrails.
# Documentation: https://koffih.github.io/perpetua/
set -euo pipefail

readonly VERSION="1.1.0"

self=$(readlink -f "$0")
root=$(cd "$(dirname "$self")/.." && pwd)
LIBEXEC=${PERPETUA_LIBEXEC:-$root/libexec/perpetua}
SHARE=${PERPETUA_SHARE:-$root/share/perpetua}
CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}/perpetua
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}/perpetua
UNIT_DIR=${PERPETUA_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}
SYSTEMCTL=${PERPETUA_SYSTEMCTL:-systemctl}

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
	B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' N=$'\e[0m'
else
	B='' D='' R='' G='' Y='' C='' N=''
fi

die() { printf '%sperpetua:%s %s\n' "$R" "$N" "$1" >&2; exit "${2:-1}"; }
need_value() { [[ $2 -ge 2 && -n $3 ]] || die "option $1 needs a value" 2; }
info() { printf '%s==>%s %s\n' "$C" "$N" "$*"; }
ok() { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
bad() { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }

usage() {
	cat <<EOF
${B}perpetua${N} $VERSION: continuous, unattended Claude Code sessions with guardrails.

${B}Usage${N}
  perpetua <command> [arguments]

${B}Lifecycle${N}
  init [DIR] [--name NAME]          register a project and scaffold .perpetua/
  enable NAME [--interval 15min]    install the systemd units and start the cadence
  disable NAME                      stop the cadence (a running session finishes)
  remove NAME [--purge]             unregister; --purge also deletes its state

${B}Operation${N}
  run NAME [--force]                run one session now, in the foreground
  pause NAME | resume NAME          raise or clear the stop flag
  status [NAME]                     cadence, gates and last outcome
  list                              registered projects
  logs NAME [-f]                    runner log (one line per wake-up)
  summaries NAME [-n N]             the agents' closing reports
  doctor                            check the host and the installation

${B}Other${N}
  version | help

Documentation: https://koffih.github.io/perpetua/
EOF
}

conf_of() { echo "$CONFIG_HOME/projects/$1.env"; }

need_project() {
	[[ $# -ge 1 && -n $1 ]] || die "a project name is required (see: perpetua list)" 2
	[[ -r $(conf_of "$1") ]] || die "unknown project '$1' (see: perpetua list)" 2
}

conf_get() { # conf_get NAME KEY: value of KEY in the project file, defaults applied by the runner
	(
		set +u
		# shellcheck source=/dev/null
		. "$(conf_of "$1")"
		eval "printf '%s' \"\${$2:-}\""
	)
}

valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; }

have_systemd() { command -v "$SYSTEMCTL" > /dev/null && "$SYSTEMCTL" --user show-environment > /dev/null 2>&1; }

# ---- init -----------------------------------------------------------------------------------
cmd_init() {
	local dir=. name=
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--name) need_value "$1" $# "${2:-}"; name=$2; shift 2 ;;
			-*) die "unknown option $1" 2 ;;
			*) dir=$1; shift ;;
		esac
	done
	dir=$(cd "$dir" 2> /dev/null && pwd) || die "no such directory: $dir" 2
	[[ -n $name ]] || name=$(basename "$dir" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^[-_]+//; s/-+$//')
	valid_name "$name" || die "invalid name '$name': use a-z, 0-9, '-' and '_' (--name)" 2
	local conf
	conf=$(conf_of "$name")
	[[ -e $conf ]] && die "project '$name' is already registered ($conf)" 2

	mkdir -p "$CONFIG_HOME/projects" "$dir/.perpetua"
	local quoted
	quoted=$(printf '%q' "$dir")
	NAME=$name DIR=$quoted python3 -c '
import os, sys
text = open(sys.argv[1]).read()
sys.stdout.write(text.replace("@NAME@", os.environ["NAME"]).replace("@PROJECT_DIR@", os.environ["DIR"]))
' "$SHARE/templates/project.env" > "$conf"
	if [[ ! -e $dir/.perpetua/directive.md ]]; then
		cp "$SHARE/templates/directive.md" "$dir/.perpetua/directive.md"
	fi
	if [[ ! -e $dir/.perpetua/.gitignore ]]; then
		printf 'STOP\n' > "$dir/.perpetua/.gitignore"
	fi

	info "Registered ${B}$name${N}"
	ok "configuration   $conf"
	ok "directive       $dir/.perpetua/directive.md"
	ok "state           $STATE_HOME/$name/"
	cat <<EOF

${B}Next${N}
  1. Review the directive: it is the standing order every session receives.
  2. Run one supervised session:   perpetua run $name --force
  3. Start the cadence:            perpetua enable $name
EOF
}

# ---- systemd --------------------------------------------------------------------------------
render_units() {
	mkdir -p "$UNIT_DIR"
	local libexec
	libexec=$(cd "$LIBEXEC" && pwd)
	sed "s|@LIBEXECDIR@|$libexec|g" "$SHARE/systemd/perpetua@.service" > "$UNIT_DIR/perpetua@.service"
	cp "$SHARE/systemd/perpetua@.timer" "$UNIT_DIR/perpetua@.timer"
}

cmd_enable() {
	local name=${1:-} interval=
	need_project "$name"; shift
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--interval) need_value "$1" $# "${2:-}"; interval=$2; shift 2 ;;
			*) die "unknown option $1" 2 ;;
		esac
	done
	have_systemd || die "systemd user instance unavailable (see: perpetua doctor)"
	render_units
	local dropin="$UNIT_DIR/perpetua@$name.timer.d"
	if [[ -n $interval ]]; then
		[[ $interval =~ ^[0-9]+(s|min|h)?$ ]] || die "invalid interval '$interval' (examples: 900, 15min, 1h)" 2
		mkdir -p "$dropin"
		printf '[Timer]\nOnUnitInactiveSec=\nOnUnitInactiveSec=%s\n' "$interval" > "$dropin/10-interval.conf"
	fi
	"$SYSTEMCTL" --user daemon-reload
	"$SYSTEMCTL" --user enable --now "perpetua@$name.timer" > /dev/null
	info "Cadence enabled for ${B}$name${N}"
	local effective=15min
	[[ -f $dropin/10-interval.conf ]] && effective=$(sed -n 's/^OnUnitInactiveSec=\(..*\)$/\1/p' "$dropin/10-interval.conf" | tail -n1)
	ok "timer perpetua@$name.timer, next session ${effective} after each run ends"
	if command -v loginctl > /dev/null && [[ $(loginctl show-user "$USER" -p Linger --value 2> /dev/null) != yes ]]; then
		warn "lingering is off: sessions stop when you log out (fix: loginctl enable-linger $USER)"
	fi
}

cmd_disable() {
	local name=${1:-}
	need_project "$name"
	have_systemd || die "systemd user instance unavailable"
	"$SYSTEMCTL" --user disable --now "perpetua@$name.timer" > /dev/null 2>&1 || true
	info "Cadence disabled for ${B}$name${N} (a running session finishes normally)"
}

cmd_remove() {
	local name=${1:-} purge=0
	need_project "$name"
	[[ ${2:-} == --purge ]] && purge=1
	if have_systemd; then
		"$SYSTEMCTL" --user disable --now "perpetua@$name.timer" > /dev/null 2>&1 || true
		rm -rf "$UNIT_DIR/perpetua@$name.timer.d"
		"$SYSTEMCTL" --user daemon-reload || true
	fi
	rm -f "$(conf_of "$name")"
	((purge)) && rm -rf "${STATE_HOME:?}/$name"
	info "Removed ${B}$name${N}$( ((purge)) && echo ' and its state')"
}

# ---- operation ------------------------------------------------------------------------------
cmd_run() {
	local name=${1:-}
	need_project "$name"; shift
	exec "$LIBEXEC/session" "$name" "$@"
}

cmd_pause() {
	need_project "${1:-}"
	mkdir -p "$STATE_HOME/$1"
	date '+%F %T' > "$STATE_HOME/$1/paused"
	info "${B}$1${N} paused: no new session starts (a running one finishes)"
}

cmd_resume() {
	need_project "${1:-}"
	rm -f "$STATE_HOME/$1/paused" "$STATE_HOME/$1/backoff-until"
	info "${B}$1${N} resumed"
	[[ -e $(conf_get "$1" PROJECT_DIR)/.perpetua/STOP ]] && warn "the project still holds .perpetua/STOP"
	return 0
}

projects() {
	local f
	for f in "$CONFIG_HOME"/projects/*.env; do
		[[ -e $f ]] && basename "$f" .env
	done
	return 0
}

cmd_list() {
	local p any=0
	for p in $(projects); do
		any=1
		printf '%-24s %s\n' "$p" "$(conf_get "$p" PROJECT_DIR)"
	done
	((any)) || echo "No project registered. Start with: perpetua init /path/to/project"
}

last_field() { # last_field STATE_DIR KEY
	python3 - "$1/last-session.json" "$2" 2> /dev/null <<'PY' || true
import json, sys
try:
    value = json.load(open(sys.argv[1])).get(sys.argv[2])
except (OSError, ValueError):
    sys.exit(0)
print("" if value is None else value)
PY
}

status_one() {
	local name=$1 st="$STATE_HOME/$1" timer="disabled" next="" state="ready" outcome when
	if have_systemd; then
		# A oneshot service is "activating" for the whole duration of its run.
		if [[ $("$SYSTEMCTL" --user show -p ActiveState --value "perpetua@$name.service" 2> /dev/null) =~ ^(activating|active)$ ]]; then
			state="${G}session running${N}"
		fi
		if "$SYSTEMCTL" --user is-enabled --quiet "perpetua@$name.timer" 2> /dev/null; then
			timer="enabled"
			next=$("$SYSTEMCTL" --user list-timers "perpetua@$name.timer" --no-legend 2> /dev/null | awk '{print $1, $2, $3}')
		fi
	fi
	local dir
	dir=$(conf_get "$name" PROJECT_DIR)
	[[ -e $st/paused || -e $dir/.perpetua/STOP ]] && state="${Y}paused${N}"
	if [[ -f $st/backoff-until ]] && (($(date +%s) < $(cat "$st/backoff-until"))); then
		state="${Y}backing off until $(date -d "@$(cat "$st/backoff-until")" '+%F %T')${N}"
	fi
	outcome=$(last_field "$st" outcome)
	when=$(last_field "$st" started_at)
	case "$outcome" in
		ok) outcome="${G}ok${N}" ;;
		"") outcome="${D}none yet${N}" ;;
		*) outcome="${R}$outcome${N}" ;;
	esac
	printf '%s%s%s\n' "$B" "$name" "$N"
	printf '  %-14s %s\n' project "$dir" cadence "$timer${next:+, next $next}" state "$state" \
		"last session" "$outcome${when:+ ${D}($when)${N}}"
	[[ -f $st/runner.log ]] && printf '  %-14s %s\n' "last wake-up" "$(tail -n1 "$st/runner.log")"
	return 0
}

cmd_status() {
	if [[ -n ${1:-} ]]; then
		need_project "$1"
		status_one "$1"
		return
	fi
	local p any=0
	for p in $(projects); do
		((any)) && echo
		any=1
		status_one "$p"
	done
	((any)) || echo "No project registered. Start with: perpetua init /path/to/project"
}

cmd_logs() {
	need_project "${1:-}"
	local f="$STATE_HOME/$1/runner.log"
	[[ -f $f ]] || die "no log yet for '$1'"
	if [[ ${2:-} == -f ]]; then tail -n 40 -f "$f"; else tail -n 40 "$f"; fi
}

cmd_summaries() {
	need_project "${1:-}"
	local f="$STATE_HOME/$1/summaries.md" n=3
	[[ ${2:-} == -n ]] && n=${3:-3}
	[[ -f $f ]] || die "no session summary yet for '$1'"
	awk -v n="$n" '/^## /{c++} {buf[c]=buf[c] $0 "\n"} END{s=c-n+1; if(s<1)s=1; for(i=s;i<=c;i++) printf "%s", buf[i]}' "$f"
}

# ---- doctor ---------------------------------------------------------------------------------
cmd_doctor() {
	local fail=0
	info "Perpetua $VERSION"
	if command -v claude > /dev/null; then ok "Claude Code $(claude --version 2> /dev/null | head -n1)"; else bad "Claude Code not found in PATH"; fail=1; fi
	local envfile=$CONFIG_HOME/environment
	if [[ -f $HOME/.claude/.credentials.json || -n ${ANTHROPIC_API_KEY:-} || -n ${CLAUDE_CODE_OAUTH_TOKEN:-} ]] \
		|| grep -qE '^(export )?(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=.' "$envfile" 2> /dev/null; then
		ok "Claude credentials present"
	else
		warn "no Claude credentials found (run: claude, then /login; on a server: claude setup-token)"
	fi
	if [[ -f $envfile ]]; then
		if [[ $(stat -c %a "$envfile" 2> /dev/null) == 600 ]]; then ok "environment file $envfile (mode 600)"; else warn "environment file readable by others: chmod 600 $envfile"; fi
	fi
	if [[ -d $HOME/.claude/skills/autonomous-mode ]]; then ok "autonomous-mode skill installed"; else warn "autonomous-mode skill missing (the default PROMPT uses it)"; fi
	if command -v python3 > /dev/null && python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))'; then ok "python3 $(python3 -c 'import platform; print(platform.python_version())')"; else bad "python3 3.8+ required"; fail=1; fi
	local tool
	for tool in flock timeout find; do
		if command -v "$tool" > /dev/null; then ok "$tool"; else bad "$tool missing"; fail=1; fi
	done
	if have_systemd; then ok "systemd user instance"; else bad "systemd user instance unavailable"; fail=1; fi
	if command -v loginctl > /dev/null; then
		if [[ $(loginctl show-user "$USER" -p Linger --value 2> /dev/null) == yes ]]; then ok "lingering enabled"; else warn "lingering off: loginctl enable-linger $USER"; fi
	fi
	if grep -qi microsoft /proc/version 2> /dev/null; then
		if pgrep -f 'sleep infinity' > /dev/null; then ok "WSL keep-alive client detected"; else warn "WSL without keep-alive: see https://koffih.github.io/perpetua/guides/wsl/"; fi
	fi
	if [[ -f $UNIT_DIR/perpetua@.service ]]; then ok "units installed in $UNIT_DIR"; else warn "units not installed yet (perpetua enable installs them)"; fi
	((fail)) && { echo; die "the host is not ready"; }
	echo
	info "Host ready"
}

main() {
	local cmd=${1:-help}
	shift || true
	case "$cmd" in
		init) cmd_init "$@" ;;
		enable) cmd_enable "$@" ;;
		disable) cmd_disable "$@" ;;
		remove) cmd_remove "$@" ;;
		run) cmd_run "$@" ;;
		pause) cmd_pause "$@" ;;
		resume) cmd_resume "$@" ;;
		status) cmd_status "$@" ;;
		list | ls) cmd_list ;;
		logs | log) cmd_logs "$@" ;;
		summaries | summary) cmd_summaries "$@" ;;
		doctor) cmd_doctor ;;
		version | --version | -V) echo "perpetua $VERSION" ;;
		help | --help | -h) usage ;;
		*) usage >&2; die "unknown command '$cmd'" 2 ;;
	esac
}

main "$@"
